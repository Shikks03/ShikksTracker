# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets. `.env*` covers .env, .env.local,
# .env.production, .env.local.bak etc; only the placeholder template is tracked.
.env*
!.env.example

# vercel
.vercel

# ---------------------------------------------------------------------------
# AI agent + planning artifacts — local working material, not shipped code.
# These files still live on disk; they are just no longer tracked by git.
# ---------------------------------------------------------------------------

# agent instruction / config files
/CLAUDE.md
/AGENTS.md
/.claude/
/.codex/
/.cursor/
/.github/copilot-instructions.md
/GEMINI.md

# brainstorming visual companion sessions
/.superpowers/

# AI-authored plans, specs, audits and build logs
/docs/superpowers/
/docs/design-brief.md
/IMPLEMENTATION_PLAN.md
/GAPS.md
/SESSION_NOTES.md
/SPEC.md

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling binaries (cloudflared.exe for tunnel testing — never commit binaries)
/tools/

# generated knowledge-graph output (rebuildable via /graphify)
/graphify-out/

# GSD planning workspace state (generated graphs/config)
/.planning/

# design handoff assets (screenshots + HTML mockups, ~2 MB).
# SESSION_NOTES calls this the visual source of truth — delete this line
# if you decide it should be versioned with the repo.
/design reference/

.vercel
