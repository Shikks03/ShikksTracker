MONGODB_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
APP_BASE_URL=            # tracking pixel, click redirects, alert links
CRON_SECRET=             # protects the sequence-engine endpoint
DASHBOARD_PASSWORD=      # required — password for the /login page; MINIMUM 12 CHARS (login fails closed with 503 below that)
SESSION_SECRET=          # required — HMAC key for the session cookie. MINIMUM 32 CHARS, random,
                         # and MUST be different from DASHBOARD_PASSWORD. Generate with:
                         #   PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
                         # The cookie is NEVER derived from the password — doing so made every
                         # issued cookie an offline password-cracking oracle (fixed 2026-07-31).
                         # Rotating this value invalidates all sessions everywhere: it is the
                         # "log out of all devices" / revocation lever.
OS_API_SECRET=           # required only if RikuOS is connected — guards /api/os/*.
                         # MINIMUM 32 CHARS, random, and different from every other secret.
                         # Generate with:
                         #   PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
                         # Sent by RikuOS as the `x-os-secret` request header. The routes fail
                         # closed with 503 when it is unset or too short.
# ALLOW_OAUTH_BOOTSTRAP=true  # uncomment to enable /api/auth/gmail in non-development environments (one-time token bootstrap only)
# ALLOW_TEST_ROUTES=true      # uncomment to enable /api/test/* outside development (they send real mail and spend Anthropic credits)

# Later, if the takeover alert is upgraded beyond email:
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional tuning (defaults shown) ---
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DAILY_SEND_CAP=15
# SENDS_PER_RUN=1        # default 1 for Vercel Hobby safety (no inter-send sleep in cron; raise only on a plan with longer function duration)
# DRAFTS_PER_RUN=10
# HOT_LEAD_THRESHOLD=5
# NEXT_PUBLIC_HOT_LEAD_THRESHOLD=5  # UI-side mirror of HOT_LEAD_THRESHOLD (non-secret; inlined into the client bundle at build). Keep the two in sync — the frontend uses this for HOT highlighting, the backend uses HOT_LEAD_THRESHOLD for the ?hot=true filter.
# BOUNCE_POLL_DETECTION=true  # set to "false" to disable mailer-daemon NDR scanning in reply poll (default: enabled)
# SEND_BATCH_MAX=5            # max approved logs per /api/send-batch request; the review UI chunks larger selections and spaces them client-side (1500–4000 ms between chunks)

# --- Security tuning (defaults shown; added 2026-07-31, security-phase-2) ---
# LOGIN_MAX_PER_IP=5          # failed logins per IP before a 429 lockout
# LOGIN_MAX_GLOBAL=20         # failed logins across all IPs in the window (backstop against IP rotation)
# LOGIN_WINDOW_MINUTES=15     # lockout window; also the TTL on LoginAttempt docs
# MAX_IMPORT_BYTES=2000000    # reject a CSV upload larger than this with 413
# MAX_IMPORT_ROWS=5000        # reject a parsed CSV with more rows than this with 413
